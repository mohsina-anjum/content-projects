# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# SMTP — used to email new hires their checklist link when they're added.
# If these are left unset, the app just logs what it would have sent and
# skips it (see server/src/email.ts), so the rest of the app works fine
# without this configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=

# Optional — base URL used to build the checklist link in invite emails.
# Change this once the app is deployed somewhere other than localhost.
APP_BASE_URL=http://localhost:5173
